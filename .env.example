# --- AI (Claude) ------------------------------------------------------------
# Enables AI classification, vision for scanned PDFs, and layout mapping.
ANTHROPIC_API_KEY=
# XVERIS_MODEL=claude-opus-5
# XVERIS_AI=off            # force the rule engine only

# --- Data ---------------------------------------------------------------------
# Default: the bundled sample inbox in data/sample.
# XVERIS_DATA_DIR=/path/to/sdoc-hackathon-bundle
# The organisers' Docker server: reads from it and enables self-evaluation.
# XVERIS_SOURCE_URL=http://localhost:8080

# --- Storage ------------------------------------------------------------------
# Postgres (Cloud SQL, Neon, Supabase...). Without it, runs are JSON files in .xveris/.
# DATABASE_URL=postgres://user:pass@host:5432/xveris

# --- Gmail --------------------------------------------------------------------
# OAuth client (Google Cloud console -> APIs & Services -> Credentials, "Web application").
# Authorised redirect URI: <XVERIS_PUBLIC_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string; encrypts the Gmail session cookie.
XVERIS_SECRET=
# Public URL of this deployment (used for the OAuth redirect).
# XVERIS_PUBLIC_URL=https://xveris-xxxx.a.run.app
# GMAIL_QUERY=newer_than:14d -in:chats -in:sent
# GMAIL_MAX_MESSAGES=150
